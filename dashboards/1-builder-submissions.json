{
  "title": "Helix - Builder Submissions",
  "tags": ["helix", "builder", "submissions"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "loki_datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "postgres_datasource",
        "label": "TimescaleDB",
        "type": "datasource",
        "query": "postgres"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "constant",
        "current": {
          "value": "relay-helix",
          "text": "relay-helix"
        },
        "hide": 2
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "custom",
        "query": "relay-api-auction-helix,relay-api-registration-helix,relay-api-data-helix",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "includeAll": true,
        "allValue": "relay-api-.*-helix"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Submissions Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(helix_request_status_total{exported_endpoint=\"/relay/v1/builder/blocks\"}[$__rate_interval]))",
          "legendFormat": "Submissions/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 2,
      "title": "Submission Success Rate",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(helix_request_status_total{exported_endpoint=\"/relay/v1/builder/blocks\", http_status_code=\"200\"}[$__rate_interval])) / sum(rate(helix_request_status_total{exported_endpoint=\"/relay/v1/builder/blocks\"}[$__rate_interval])) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 80, "color": "yellow"},
              {"value": 95, "color": "green"}
            ]
          },
          "decimals": 2
        }
      }
    },
    {
      "id": 3,
      "title": "Submissions by Status Code",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "sum by (http_status_code) (rate(helix_request_status_total{exported_endpoint=\"/relay/v1/builder/blocks\"}[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "mean"]
        }
      }
    },
    {
      "id": 6,
      "title": "Validation Failures by Error Type",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (err) (count_over_time({namespace=\"${namespace}\", app=~\"${deployment}\"} |~ \"submit_block\" |~ \"err=\" | pattern `<_> submit_block{<_>}: <err_msg>` | err_msg =~ \".*err=.*\" [$__interval]))",
          "legendFormat": "{{err}}",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          }
        }
      ],
      "description": "Validation errors from submit_block handler logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars"
          }
        }
      },
      "interval": "12s"
    },
    {
      "id": 7,
      "title": "Submission Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(helix_request_latency_secs_bucket{exported_endpoint=\"/relay/v1/builder/blocks\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "datasource": {"type": "prometheus", "uid": "${datasource}"}
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(helix_request_latency_secs_bucket{exported_endpoint=\"/relay/v1/builder/blocks\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "datasource": {"type": "prometheus", "uid": "${datasource}"}
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(helix_request_latency_secs_bucket{exported_endpoint=\"/relay/v1/builder/blocks\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "datasource": {"type": "prometheus", "uid": "${datasource}"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2}
        }
      }
    }
  ]
}
