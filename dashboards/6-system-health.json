{
  "title": "Helix - System Health & Performance",
  "tags": ["helix", "system", "health"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
      "from": "now-15m",
      "to": "now"
  },
  "templating": {
    "list": [
        {
          "name": "datasource",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus"
        },
        {
          "name": "namespace",
          "label": "Namespace",
          "type": "constant",
          "current": {
            "value": "relay-helix",
            "text": "relay-helix"
          },
          "hide": 2
        }
    ]
  },
  "panels": [
      {
        "id": 1,
        "title": "Request Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum by (exported_endpoint) (rate(helix_request_status_total[$__rate_interval]))",
            "legendFormat": "{{endpoint}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right"
          }
        }
      },
      {
        "id": 2,
        "title": "Pending Requests by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum by (exported_endpoint) (helix_request_pending)",
            "legendFormat": "{{endpoint}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Database Operation Latency (p95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (exported_endpoint, le) (rate(helix_db_latency_secs_bucket[$__rate_interval])))",
            "legendFormat": "{{endpoint}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "lineWidth": 2
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Database Success Rate",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(helix_db_count_total{is_success=\"true\"}[$__rate_interval])) / sum(rate(helix_db_count_total[$__rate_interval])) * 100",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 95, "color": "yellow"},
                {"value": 99, "color": "green"}
              ]
            },
            "decimals": 2
          }
        }
      },
      {
        "id": 5,
        "title": "Beacon Node Sync Status",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
        "targets": [
          {
            "expr": "helix_beacon_synced{beacon=~\".*\"}",
            "legendFormat": "{{beacon}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "Not Synced",
                    "color": "red"
                  }
                }
              },
              {
                "type": "value",
                "options": {
                  "1": {
                    "text": "Synced",
                    "color": "green"
                  }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      {
        "id": 6,
        "title": "Worker Queue Lengths",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "avg by (type) (helix_worker_queue_len)",
            "legendFormat": "{{type}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Worker Utilization",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "sum by (worker) (helix_worker_utilization)",
            "format": "heatmap",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "options": {
          "color": {
            "mode": "scheme",
            "scheme": "Spectral"
          }
        }
      },
      {
        "id": 8,
        "title": "Request Timeouts by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum by (exported_endpoint) (rate(helix_request_timeout_total[$__rate_interval]))",
            "legendFormat": "{{endpoint}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "drawStyle": "bars"
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Tokio Task Count",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "sum by (origin) (helix_tokio_tasks)",
            "legendFormat": "{{origin}}",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "lineWidth": 2
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Gossip Message Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "sum(rate(helix_in_gossip_count_total[$__rate_interval]))",
            "legendFormat": "Incoming",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          },
          {
            "expr": "sum(rate(helix_out_gossip_count_total{is_success=\"true\"}[$__rate_interval]))",
            "legendFormat": "Outgoing (success)",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "msgs/s",
            "custom": {
              "lineWidth": 2
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Cache Hit Rates",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "rate(helix_delivered_payloads_cache_hit[$__rate_interval])",
            "legendFormat": "Delivered Payloads",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          },
          {
            "expr": "rate(helix_bids_cache_hit[$__rate_interval])",
            "legendFormat": "Bids",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "lineWidth": 2
            }
          }
        }
      }
    ]
  }
}
